# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# lib/env.ts 가 부팅 시점에 zod로 검증합니다.
# NEXT_PUBLIC_SITE_URL 을 뺀 나머지는 전부 필수이며, 하나라도 비어 있으면 기동 단계에서 실패합니다.

# ── 브라우저에 노출됨 (NEXT_PUBLIC_) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_PAY_CHANNEL_KEY=
# PortOne 콘솔의 본인인증 채널 키 (결제 채널 키와 다름)
NEXT_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY=
# 본인인증 토스 채널 키 — hooks/use-portone.ts 에서 사용
NEXT_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY_TOSS=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# 선택 — metadataBase / sitemap 의 기준 URL (예: https://example.com)
# 비워두면 Next가 VERCEL_URL 로 대체하므로 빌드는 통과합니다.
NEXT_PUBLIC_SITE_URL=

# ── 서버 전용 ─ 여기엔 절대 NEXT_PUBLIC_ 을 붙이지 마세요 ──────────
SUPABASE_SERVICE_ROLE_KEY=
PORTONE_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 참고: 카카오/구글 소셜 로그인 키는 여기가 아니라 Supabase 대시보드
# (Authentication > Providers)에 등록합니다. 앱 코드에서 직접 읽지 않습니다.
